# Dockerfile.base: shared runtime for concordia-bench (image concordia-bench-base:latest).
#
# Build context: bench/.build/base, assembled by scripts/build-images.sh. It contains
#   concordia               static binary built from this checkout
#   codebase-memory-mcp     the pinned CBM binary from .bin/
#   docs/                   Concordia documentation for the agent
#   lib/                    the verifier library and helper scripts
#
# Do not set CI here: `assessment approve|revoke` and `baseline update --accept`
# refuse to run under CI (CO-ASM-005, CO-EXC-008).
FROM debian:bookworm-slim

RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends \
        bash bubblewrap ca-certificates curl git jq openjdk-17-jre-headless procps python3 \
        python3-venv tmux unzip \
    && rm -rf /var/lib/apt/lists/*

# Renderers of the assurance adapters; Concordia accepts any version that matches its lock pin.
ARG HELM_VERSION=v4.3.2
ARG HELM_SHA256=d1c0278d46beab79582d7e50f5b3dc206944ba8e577cde618513fd07daa53983
ARG KUSTOMIZE_VERSION=v5.8.3
ARG KUSTOMIZE_SHA256=cb9e31198d3f63b44848bd0afc4c8efc56e6cfef9c93a4a39a211940e6decd61
RUN curl -fsSLo /tmp/helm.tgz "https://get.helm.sh/helm-${HELM_VERSION}-linux-amd64.tar.gz" \
    && echo "${HELM_SHA256}  /tmp/helm.tgz" | sha256sum -c - \
    && tar -xzf /tmp/helm.tgz -C /tmp linux-amd64/helm \
    && mv /tmp/linux-amd64/helm /usr/local/bin/helm \
    && curl -fsSLo /tmp/kustomize.tgz \
        "https://github.com/kubernetes-sigs/kustomize/releases/download/kustomize%2F${KUSTOMIZE_VERSION}/kustomize_${KUSTOMIZE_VERSION}_linux_amd64.tar.gz" \
    && echo "${KUSTOMIZE_SHA256}  /tmp/kustomize.tgz" | sha256sum -c - \
    && tar -xzf /tmp/kustomize.tgz -C /usr/local/bin kustomize \
    && rm -rf /tmp/helm.tgz /tmp/linux-amd64 /tmp/kustomize.tgz \
    && helm version --short && kustomize version

# Structurizr CLI for `concordia render --views`. Harbor tasks have no Docker socket,
# so the CLI runs natively; Concordia finds structurizr.sh on PATH and passes it only
# PATH and JAVA_HOME.
ARG STRUCTURIZR_VERSION=2025.11.09
ARG STRUCTURIZR_SHA256=f5365a463fc44d539ed19bec00c48ba1e1ecda0ccfd1ba40d2e7472d264eb79a
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
RUN curl -fsSLo /tmp/s.zip "https://github.com/structurizr/cli/releases/download/v${STRUCTURIZR_VERSION}/structurizr-cli.zip" \
    && echo "${STRUCTURIZR_SHA256}  /tmp/s.zip" | sha256sum -c - \
    && unzip -q /tmp/s.zip -d /opt/structurizr-cli \
    && rm /opt/structurizr-cli/*.bat /tmp/s.zip \
    && chmod +x /opt/structurizr-cli/structurizr.sh \
    && ln -s /opt/structurizr-cli/structurizr.sh /usr/local/bin/structurizr.sh \
    && structurizr.sh version | grep -qx "structurizr-cli: ${STRUCTURIZR_VERSION}"

COPY --from=ghcr.io/astral-sh/uv:0.13.7 /uv /uvx /usr/local/bin/
RUN uv venv /opt/venv --python /usr/bin/python3 \
    && uv pip install --python /opt/venv/bin/python pyyaml==6.0.2

COPY concordia codebase-memory-mcp /usr/local/bin/
COPY docs /opt/concordia/docs
COPY lib/concordia_bench /opt/concordia-bench/python/concordia_bench
COPY lib/bin /opt/concordia-bench/bin

RUN git config --system user.name "Concordia Bench" \
    && git config --system user.email bench@concordia-bench.invalid \
    && git config --system commit.gpgsign false \
    && git config --system init.defaultBranch main \
    && git config --system safe.directory '*'

RUN concordia --version && codebase-memory-mcp --version
WORKDIR /workspace/repo
