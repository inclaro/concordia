{
  "$schema": "https://calm.finos.org/release/1.3/meta/calm.json",
  "nodes": [
    {
      "unique-id": "af-api-server",
      "node-type": "service",
      "name": "Api Server",
      "description": "Public REST API server and UI backend.",
      "concordia": {
        "tags": [
          "presentation",
          "deployable"
        ]
      }
    },
    {
      "unique-id": "af-execution-api",
      "node-type": "service",
      "name": "Execution Api",
      "description": "Internal Execution API that workers call instead of the database.",
      "concordia": {
        "tags": [
          "contract"
        ]
      }
    },
    {
      "unique-id": "af-scheduler",
      "node-type": "service",
      "name": "Scheduler",
      "description": "Scheduler, triggerer and job runners.",
      "concordia": {
        "tags": [
          "deployable"
        ]
      }
    },
    {
      "unique-id": "af-dag-processing",
      "node-type": "service",
      "name": "Dag Processing",
      "description": "DAG file parsing and bundle management.",
      "concordia": {
        "tags": [
          "deployable"
        ]
      }
    },
    {
      "unique-id": "af-executors",
      "node-type": "service",
      "name": "Executors",
      "description": "Executors that dispatch workloads to workers."
    },
    {
      "unique-id": "af-models",
      "node-type": "service",
      "name": "Models",
      "description": "ORM models of the metadata database.",
      "concordia": {
        "tags": [
          "domain"
        ]
      }
    },
    {
      "unique-id": "af-metadata-db",
      "node-type": "database",
      "name": "Metadata Db",
      "description": "Session and engine access to the metadata database."
    },
    {
      "unique-id": "af-task-sdk",
      "node-type": "service",
      "name": "Task Sdk",
      "description": "Public Task SDK for authoring DAGs and tasks.",
      "concordia": {
        "tags": [
          "contract"
        ]
      }
    },
    {
      "unique-id": "af-task-runner",
      "node-type": "service",
      "name": "Task Runner",
      "description": "Task execution runtime that runs inside workers."
    },
    {
      "unique-id": "af-provider-standard",
      "node-type": "service",
      "name": "Provider Standard",
      "description": "The standard provider with core operators and sensors."
    },
    {
      "unique-id": "af-namespace",
      "node-type": "system",
      "name": "Airflow Namespace",
      "description": "The Kubernetes namespace that hosts the Airflow control plane."
    }
