      "unique-id": "argo-apis",
      "node-type": "service",
      "name": "Argo Apis",
      "description": "API types and generated gRPC clients.",
      "concordia": {
        "tags": [
          "contract"
        ]
      }
    },
    {
      "unique-id": "argo-db",
      "node-type": "service",
      "name": "Argo Db",
      "description": "Settings and credential store access.",
      "concordia": {
        "tags": [
          "restricted"
        ]
      }
    },
    {
      "unique-id": "argo-util",
      "node-type": "service",
      "name": "Argo Util",
      "description": "Shared utilities.",
      "concordia": {
        "tags": [
          "shared"
        ]
      }
    }
