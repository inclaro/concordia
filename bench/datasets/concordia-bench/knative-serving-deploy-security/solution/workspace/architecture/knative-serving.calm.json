{
  "$schema": "https://calm.finos.org/release/1.3/meta/calm.json",
  "nodes": [
    {
      "unique-id": "kn-activator",
      "node-type": "service",
      "name": "Kn Activator",
      "description": "Request buffer and proxy that wakes revisions scaled to zero.",
      "concordia": {
        "tags": [
          "deployable",
          "public"
        ]
      }
    },
    {
      "unique-id": "kn-autoscaler",
      "node-type": "service",
      "name": "Kn Autoscaler",
      "description": "Autoscaler that decides how many pods each revision needs.",
      "concordia": {
        "tags": [
          "deployable"
        ]
      }
    },
    {
      "unique-id": "kn-controller",
      "node-type": "service",
      "name": "Kn Controller",
      "description": "Reconcilers for services, routes, configurations and revisions.",
      "concordia": {
        "tags": [
          "deployable"
        ]
      }
    },
    {
      "unique-id": "kn-webhook",
      "node-type": "service",
      "name": "Kn Webhook",
      "description": "Admission webhook that defaults and validates Serving resources.",
      "concordia": {
        "tags": [
          "deployable"
        ]
      }
    },
    {
      "unique-id": "kn-queue",
      "node-type": "service",
      "name": "Kn Queue",
      "description": "Queue-proxy sidecar that runs in every user pod."
    },
    {
      "unique-id": "kn-apis",
      "node-type": "service",
      "name": "Kn Apis",
      "description": "API types of the Serving resources.",
      "concordia": {
        "tags": [
          "contract"
        ]
      }
    },
    {
      "unique-id": "kn-client",
      "node-type": "service",
      "name": "Kn Client",
      "description": "Generated clients, informers and listers.",
      "concordia": {
        "tags": [
          "contract"
        ]
      }
    },
    {
      "unique-id": "kn-shared",
      "node-type": "service",
      "name": "Kn Shared",
      "description": "Shared HTTP, logging, metrics, networking and resource helpers.",
      "concordia": {
        "tags": [
          "shared"
        ]
      }
    },
    {
      "unique-id": "kn-ns",
      "node-type": "system",
      "name": "Kn Ns",
      "description": "The knative-serving namespace that hosts the control plane."
    },
    {
      "unique-id": "kn-testing-ns",
      "node-type": "system",
      "name": "Kn Testing Ns",
      "description": "The knative-testing namespace, which hosts no control-plane component."
    },
    {
      "unique-id": "kn-sa-controller",
      "node-type": "system",
      "name": "Kn Sa Controller",
      "description": "The shared controller service account of the Serving control plane."
    },
    {
      "unique-id": "kn-webhook-certs",
      "node-type": "data-asset",
      "name": "Kn Webhook Certs",
      "description": "The serving certificates secret of the webhook."
    }
  ],
