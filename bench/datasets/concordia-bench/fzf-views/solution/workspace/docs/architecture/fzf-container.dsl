workspace "fzf" "Generated by Concordia from CALM architecture architecture/fzf.calm.json" {
  model {
    gu_fzf = softwareSystem "Fzf" "The fzf command-line fuzzy finder." "CALM,system" {
      properties {
        "calm.unique-id" "fzf"
        "calm.node-type" "system"
      }
      gu_fzf_algo = container "Fzf Algo" "Fuzzy matching." "service" "CALM,service" {
        properties {
          "calm.unique-id" "fzf-algo"
          "calm.node-type" "service"
        }
      }
      gu_fzf_cli = container "Fzf Cli" "Entry point." "service" "CALM,service" {
        properties {
          "calm.unique-id" "fzf-cli"
          "calm.node-type" "service"
        }
      }
      gu_fzf_core = container "Fzf Core" "Option parsing and the finder loop." "service" "CALM,service" {
        properties {
          "calm.unique-id" "fzf-core"
          "calm.node-type" "service"
        }
      }
      gu_fzf_protector = container "Fzf Protector" "OS sandboxing." "service" "CALM,service" {
        properties {
          "calm.unique-id" "fzf-protector"
          "calm.node-type" "service"
        }
      }
      gu_fzf_tui = container "Fzf Tui" "Terminal rendering." "service" "CALM,service" {
        properties {
          "calm.unique-id" "fzf-tui"
          "calm.node-type" "service"
        }
      }
      gu_fzf_util = container "Fzf Util" "Utilities." "service" "CALM,service,shared" {
        properties {
          "calm.unique-id" "fzf-util"
          "calm.node-type" "service"
        }
      }
    }
    gu_fzf_algo -> gu_fzf_util "[conforming] Fzf Algo uses Fzf Util." "" "concordia:conforming" {
      properties {
        "calm.unique-id" "fzf-algo-uses-fzf-util"
      }
    }
    gu_fzf_cli -> gu_fzf_core "[conforming] Fzf Cli uses Fzf Core." "" "concordia:conforming" {
      properties {
        "calm.unique-id" "fzf-cli-uses-fzf-core"
      }
    }
    gu_fzf_cli -> gu_fzf_protector "[conforming] Fzf Cli uses Fzf Protector." "" "concordia:conforming" {
      properties {
        "calm.unique-id" "fzf-cli-uses-fzf-protector"
      }
    }
    gu_fzf_core -> gu_fzf_algo "[conforming] Fzf Core uses Fzf Algo." "" "concordia:conforming" {
      properties {
        "calm.unique-id" "fzf-core-uses-fzf-algo"
      }
    }
    gu_fzf_core -> gu_fzf_tui "[conforming] Fzf Core uses Fzf Tui." "" "concordia:conforming" {
      properties {
        "calm.unique-id" "fzf-core-uses-fzf-tui"
      }
    }
    gu_fzf_core -> gu_fzf_util "[conforming] Fzf Core uses Fzf Util." "" "concordia:conforming" {
      properties {
        "calm.unique-id" "fzf-core-uses-fzf-util"
      }
    }
    gu_fzf_tui -> gu_fzf_util "[conforming] Fzf Tui uses Fzf Util." "" "concordia:conforming" {
      properties {
        "calm.unique-id" "fzf-tui-uses-fzf-util"
      }
    }
    gu_fzf_algo -> gu_fzf_core "[observed-only] observed only" "" "concordia:observed-only" {
      properties {
        "concordia.observed-kinds" "calls"
      }
    }
    gu_fzf_algo -> gu_fzf_tui "[observed-only] observed only" "" "concordia:observed-only" {
      properties {
        "concordia.observed-kinds" "calls"
      }
    }
    gu_fzf_cli -> gu_fzf_tui "[observed-only] observed only" "" "concordia:observed-only" {
      properties {
        "concordia.observed-kinds" "calls"
      }
    }
    gu_fzf_cli -> gu_fzf_util "[observed-only] observed only" "" "concordia:observed-only" {
      properties {
        "concordia.observed-kinds" "calls"
      }
    }
    gu_fzf_core -> gu_fzf_cli "[observed-only] observed only" "" "concordia:observed-only" {
      properties {
        "concordia.observed-kinds" "calls"
      }
    }
    gu_fzf_tui -> gu_fzf_core "[observed-only] observed only" "" "concordia:observed-only" {
      properties {
        "concordia.observed-kinds" "calls"
      }
    }
    gu_fzf_util -> gu_fzf_algo "[observed-only] observed only" "" "concordia:observed-only" {
      properties {
        "concordia.observed-kinds" "calls"
      }
    }
    gu_fzf_util -> gu_fzf_core "[observed-only] observed only" "" "concordia:observed-only" {
      properties {
        "concordia.observed-kinds" "calls"
      }
    }
    gu_fzf_util -> gu_fzf_tui "[observed-only] observed only" "" "concordia:observed-only" {
      properties {
        "concordia.observed-kinds" "calls"
      }
    }
  }
  views {
    container gu_fzf "fzf-container" {
      include *
      exclude "relationship.tag==concordia:observed-only"
      autoLayout
    }
    styles {
      relationship "concordia:conforming" {
        color #2e7d32
      thickness 2
      style solid
      }
      relationship "concordia:declared-only" {
        color #1565c0
      thickness 2
      style dashed
      }
      relationship "concordia:observed-only" {
        color #ef6c00
      thickness 3
      style dotted
      }
      relationship "concordia:unknown" {
        color #6a1b9a
      thickness 2
      style dotted
      }
      relationship "concordia:violating" {
        color #c62828
      thickness 4
      style solid
      }
    }
  }
}
