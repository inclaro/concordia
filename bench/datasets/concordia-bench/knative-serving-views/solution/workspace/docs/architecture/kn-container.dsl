workspace "knative-serving" "Generated by Concordia from CALM architecture architecture/knative-serving.calm.json" {
  model {
    gu_kn_ns = softwareSystem "Kn Ns" "The knative-serving namespace that hosts the control plane." "CALM,system" {
      properties {
        "calm.unique-id" "kn-ns"
        "calm.node-type" "system"
      }
    }
    gu_kn_serving = softwareSystem "Kn Serving" "Knative Serving." "CALM,system" {
      properties {
        "calm.unique-id" "kn-serving"
        "calm.node-type" "system"
      }
      gu_kn_activator = container "Kn Activator" "Request buffer and proxy that wakes revisions scaled to zero." "service" "CALM,service,public" {
        properties {
          "calm.unique-id" "kn-activator"
          "calm.node-type" "service"
        }
      }
      gu_kn_apis = container "Kn Apis" "API types of the Serving resources." "service" "CALM,service,contract" {
        properties {
          "calm.unique-id" "kn-apis"
          "calm.node-type" "service"
        }
      }
      gu_kn_autoscaler = container "Kn Autoscaler" "Autoscaler that decides how many pods each revision needs." "service" "CALM,service" {
        properties {
          "calm.unique-id" "kn-autoscaler"
          "calm.node-type" "service"
        }
      }
      gu_kn_client = container "Kn Client" "Generated clients, informers and listers." "service" "CALM,service,contract" {
        properties {
          "calm.unique-id" "kn-client"
          "calm.node-type" "service"
        }
      }
      gu_kn_controller = container "Kn Controller" "Reconcilers for services, routes, configurations and revisions." "service" "CALM,service" {
        properties {
          "calm.unique-id" "kn-controller"
          "calm.node-type" "service"
        }
      }
      gu_kn_queue = container "Kn Queue" "Queue-proxy sidecar that runs in every user pod." "service" "CALM,service" {
        properties {
          "calm.unique-id" "kn-queue"
          "calm.node-type" "service"
        }
      }
      gu_kn_shared = container "Kn Shared" "Shared HTTP, logging, metrics, networking and resource helpers." "service" "CALM,service,shared" {
        properties {
          "calm.unique-id" "kn-shared"
          "calm.node-type" "service"
        }
      }
      gu_kn_webhook = container "Kn Webhook" "Admission webhook that defaults and validates Serving resources." "service" "CALM,service" {
        properties {
          "calm.unique-id" "kn-webhook"
          "calm.node-type" "service"
        }
      }
    }
