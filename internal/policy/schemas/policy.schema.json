{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concordia.io/schemas/v1alpha1/policy-pack.schema.json",
  "title": "Concordia PolicyPack",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "rules"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "concordia.io/v1alpha1" },
    "kind": { "const": "PolicyPack" },
    "metadata": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "selectors": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/selector" }
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "precedence": {
      "description": "Versioned precedence of rules for conflict resolution. A rule listed earlier has priority over a rule listed later.",
      "type": "object",
      "required": ["version", "order"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$" }
        }
      }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "edgeList": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "selectorValues": {
      "description": "One accepted value or a list of accepted values.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      ]
    },
    "selector": {
      "description": "Either the union of calmNodes, nodeTypes, tags and ref (resolved to CALM IDs at compile time), or exactly one dimension, or exactly one of allOf, anyOf and not. Mixing these at one level is an implicit composition and is rejected by the compiler with CO-POL-002, as is a key that is not listed here. The dimensions and the operators are valid in obligation.applies. The key deployedIn is valid only as the whole subject or the whole relation.target of an obligation block.",
      "type": "object",
      "properties": {
        "calmNodes": { "$ref": "#/$defs/stringList" },
        "nodeTypes": { "$ref": "#/$defs/stringList" },
        "tags": { "$ref": "#/$defs/stringList" },
        "ref": { "type": "string", "minLength": 1 },
        "deployedIn": { "type": "boolean", "description": "Valid only as the whole subject (true) or the whole relation.target (true or false) of an obligation block." },
        "allOf": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/selector" } },
        "anyOf": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/selector" } },
        "not": { "$ref": "#/$defs/selector" },
        "architecture": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/selectorValues" },
            "nodeType": { "$ref": "#/$defs/selectorValues" }
          }
        },
        "observedKind": { "$ref": "#/$defs/selectorValues" },
        "environment": { "$ref": "#/$defs/selectorValues" },
        "repository": { "$ref": "#/$defs/selectorValues" },
        "workload": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "cluster": { "$ref": "#/$defs/selectorValues" },
            "kind": { "$ref": "#/$defs/selectorValues" },
            "name": { "$ref": "#/$defs/selectorValues" },
            "namespace": { "$ref": "#/$defs/selectorValues" }
          }
        },
        "container": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "image": { "$ref": "#/$defs/selectorValues" },
            "name": { "$ref": "#/$defs/selectorValues" }
          }
        },
        "protocol": { "$ref": "#/$defs/selectorValues" },
        "operation": { "$ref": "#/$defs/selectorValues" },
        "interface": { "$ref": "#/$defs/selectorValues" },
        "trustContext": { "$ref": "#/$defs/selectorValues" },
        "dataClassification": { "$ref": "#/$defs/selectorValues" },
        "governanceScope": { "$ref": "#/$defs/selectorValues" },
        "evidenceRole": { "$ref": "#/$defs/selectorValues" }
      }
    },
    "evidenceRole": {
      "enum": [
        "declared-intent",
        "parsed-source-fact",
        "inferred-association",
        "runtime-observation",
        "measured-result",
        "reviewed-judgment",
        "candidate-verification-artifact"
      ]
    },
    "resolution": { "enum": ["exact", "explicitly-bound", "inferred", "ambiguous", "unresolved"] },
    "completeness": { "enum": ["any", "partial", "complete"] },
    "obligation": {
      "type": "object",
      "required": ["type", "relation"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["required", "forbidden", "allowed"] },
        "applies": { "$ref": "#/$defs/selector" },
        "relation": {
          "type": "object",
          "required": ["kind", "direction"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "minLength": 1, "description": "An edge kind token. The compiler checks it (CO-POL-004)." },
            "direction": { "enum": ["from-subject", "to-subject", "from-workload", "to-workload", "from-image"] },
            "target": { "$ref": "#/$defs/selector" }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "environments": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
            },
            "repositories": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "multiplicity": { "enum": ["exists", "forAll"] }
      }
    },
    "confidence": { "enum": ["unknown", "heuristic", "syntactic", "runtime", "resolved"] },
    "coverageRatio": { "type": "number", "minimum": 0, "maximum": 1 },
    "rule": {
      "type": "object",
      "required": ["id", "name", "severity"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$" },
        "name": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["error", "warning", "info"] },
        "rationale": { "type": "string" },
        "remediation": { "type": "string" },
        "owner": { "type": "string" },
        "aggregation": { "type": "string", "description": "edge (default), file, symbol or architecture-pair. The compiler checks the value (CO-POL-002); only rules with edge findings accept a value other than edge." },
        "family": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "The rule family that enforcement is set for." },
        "enforcement": { "enum": ["mandatory", "advisory", "shadow"] },
        "obligation": { "$ref": "#/$defs/obligation" },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimumConfidence": { "$ref": "#/$defs/confidence" },
            "minimumCoverage": { "$ref": "#/$defs/coverageRatio" },
            "onUnknown": { "enum": ["fail", "warn", "ignore"] },
            "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/evidenceRole" } },
            "minimumResolution": { "$ref": "#/$defs/resolution" },
            "completeness": { "$ref": "#/$defs/completeness" },
            "passCompleteness": { "$ref": "#/$defs/completeness" },
            "edgeKinds": { "type": "object", "additionalProperties": { "$ref": "#/$defs/confidence" } },
            "coverage": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "files": { "$ref": "#/$defs/coverageRatio" },
                "bytes": { "$ref": "#/$defs/coverageRatio" },
                "supportedLanguages": { "$ref": "#/$defs/coverageRatio" }
              }
            }
          }
        },
        "subject": { "$ref": "#/$defs/selector" },
        "forbid": {
          "type": "object",
          "required": ["target", "edges"],
          "additionalProperties": false,
          "properties": {
            "target": { "$ref": "#/$defs/selector" },
            "edges": { "$ref": "#/$defs/edgeList" },
            "traversal": { "type": "string", "description": "Only 'direct' (checked by the compiler, CO-POL-002)." }
          }
        },
        "allow": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sourceRoots": { "$ref": "#/$defs/stringList" },
                "calmNodes": { "$ref": "#/$defs/stringList" }
              }
            },
            "when": {
              "type": "object",
              "required": ["any"],
              "additionalProperties": false,
              "properties": {
                "any": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "minProperties": 1,
                    "maxProperties": 1,
                    "properties": {
                      "edge": { "type": "string", "minLength": 1 },
                      "targetTag": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            }
          }
        },
        "layerOrder": {
          "type": "object",
          "required": ["layers", "edges"],
          "additionalProperties": false,
          "properties": {
            "layers": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/selector" } },
            "edges": { "$ref": "#/$defs/edgeList" }
          }
        },
        "declaredOnly": {
          "type": "object",
          "required": ["edges"],
          "additionalProperties": false,
          "properties": {
            "edges": { "$ref": "#/$defs/edgeList" }
          }
        },
        "observedRequired": {
          "type": "object",
          "additionalProperties": false
        },
        "viewCurrency": {
          "description": "Predicate of the rules of the built-in `views` pack: `check` evaluates them from the declared views. The compiler refuses it in a workspace policy.",
          "type": "object",
          "required": ["check"],
          "additionalProperties": false,
          "properties": {
            "check": { "enum": ["presence", "freshness", "correspondence"] }
          }
        },
        "decisions": {
          "description": "Predicate of the rules of the built-in `adr-governance` pack: `check` evaluates them from the decision register. The compiler checks the obligation name (CO-POL-002).",
          "type": "object",
          "required": ["obligation"],
          "additionalProperties": false,
          "properties": {
            "obligation": { "type": "string", "minLength": 1 }
          }
        },
        "assessmentCurrency": {
          "description": "Predicate of the rules of the built-in `review-currency` pack: `check` evaluates them from the assessments and their verified approvals.",
          "enum": ["approval", "disposition", "capability", "governance"]
        },
        "denyPath": {
          "type": "object",
          "required": ["target", "edges"],
          "additionalProperties": false,
          "properties": {
            "target": { "$ref": "#/$defs/selector" },
            "edges": { "$ref": "#/$defs/edgeList" },
            "maxDepth": { "type": "integer", "minimum": 1, "maximum": 10 }
          }
        },
        "allowOnly": {
          "type": "object",
          "required": ["targets", "edges"],
          "additionalProperties": false,
          "properties": {
            "targets": { "$ref": "#/$defs/selector" },
            "edges": { "$ref": "#/$defs/edgeList" }
          }
        },
        "independent": {
          "type": "object",
          "required": ["edges"],
          "additionalProperties": false,
          "properties": {
            "edges": { "$ref": "#/$defs/edgeList" }
          }
        },
        "publicApiOnly": {
          "type": "object",
          "required": ["api", "edges"],
          "additionalProperties": false,
          "properties": {
            "target": { "$ref": "#/$defs/selector" },
            "api": {
              "type": "object",
              "required": ["sourceRoots"],
              "additionalProperties": false,
              "properties": {
                "sourceRoots": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
              }
            },
            "edges": { "$ref": "#/$defs/edgeList" }
          }
        },
        "ownership": {
          "type": "object",
          "required": ["owners", "edges"],
          "additionalProperties": false,
          "properties": {
            "owners": { "$ref": "#/$defs/selector" },
            "edges": { "$ref": "#/$defs/edgeList" }
          }
        },
        "budget": {
          "type": "object",
          "required": ["measure", "max", "edges"],
          "additionalProperties": false,
          "properties": {
            "measure": { "enum": ["forbidden-edges", "cycles"] },
            "max": { "type": "integer", "minimum": 0 },
            "target": { "$ref": "#/$defs/selector" },
            "edges": { "$ref": "#/$defs/edgeList" }
          }
        },
        "require": {
          "oneOf": [
            {
              "type": "object",
              "required": ["graphProperty", "edges", "collapseBy"],
              "additionalProperties": false,
              "properties": {
                "graphProperty": { "const": "acyclic" },
                "edges": { "$ref": "#/$defs/edgeList" },
                "collapseBy": { "const": "architectureBinding" }
              }
            },
            {
              "type": "object",
              "required": ["edge"],
              "additionalProperties": false,
              "properties": {
                "edge": {
                  "type": "object",
                  "required": ["target", "edges"],
                  "additionalProperties": false,
                  "properties": {
                    "target": { "$ref": "#/$defs/selector" },
                    "edges": { "$ref": "#/$defs/edgeList" }
                  }
                }
              }
            },
            {
              "type": "object",
              "required": ["entity"],
              "additionalProperties": false,
              "properties": {
                "entity": {
                  "type": "object",
                  "required": ["labels"],
                  "additionalProperties": false,
                  "properties": {
                    "labels": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                    "namePattern": { "type": "string", "minLength": 1 }
                  }
                }
              }
            },
            {
              "type": "object",
              "required": ["effectiveAccess"],
              "additionalProperties": false,
              "properties": {
                "effectiveAccess": {
                  "description": "The evaluated access between two sets of workloads must equal the expectation. The dimension and the expected outcome are checked by the compiler (CO-POL-002): network takes denied or allowed, authorization takes not-granted or granted.",
                  "type": "object",
                  "required": ["dimension", "from", "to", "expect"],
                  "additionalProperties": false,
                  "properties": {
                    "dimension": { "type": "string", "minLength": 1 },
                    "from": { "$ref": "#/$defs/selector" },
                    "to": { "$ref": "#/$defs/selector" },
                    "expect": { "type": "string", "minLength": 1 },
                    "ports": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 65535 } }
                  }
                }
              }
            },
            {
              "type": "object",
              "required": ["checkResult"],
              "additionalProperties": false,
              "properties": {
                "checkResult": {
                  "description": "A named check must have an admissible result. The compiler rejects a check that no control (check-ids) or result source defines (CO-POL-005).",
                  "type": "object",
                  "required": ["check"],
                  "additionalProperties": false,
                  "properties": {
                    "check": { "type": "string", "minLength": 1 },
                    "environment": { "type": "string", "minLength": 1 },
                    "subject": { "$ref": "#/$defs/selector" }
                  }
                }
              }
            },
            {
              "type": "object",
              "required": ["claim"],
              "additionalProperties": false,
              "properties": {
                "claim": {
                  "description": "A registered assurance claim must hold for every subject that the claim covers. The claim registry is read at evaluation time: a claim that no loaded contract enables is unknown with claim-not-enabled, not a compile error.",
                  "type": "object",
                  "required": ["id"],
                  "additionalProperties": false,
                  "properties": {
                    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
                    "environment": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
