workspace "Concordia" "Generated by Concordia from CALM architecture arch.json" {
  model {
    gu_gu_system_default = softwareSystem "Concordia" "" "CALM" {
      properties {
        "concordia.synthetic" "true"
      }
      gu_b = container "B" "" "service" "CALM,service" {
        properties {
          "calm.unique-id" "b"
          "calm.node-type" "service"
          "concordia.status" "none"
        }
      }
      gu_host = container "HOST" "" "service" "CALM,service" {
        properties {
          "calm.unique-id" "host"
          "calm.node-type" "service"
          "concordia.status" "none"
        }
      }
    }
    gu_sys = softwareSystem "SYS" "" "CALM,system" {
      properties {
        "calm.unique-id" "sys"
        "calm.node-type" "system"
        "concordia.status" "none"
      }
      gu_a = container "A" "" "service" "CALM,service" {
        properties {
          "calm.unique-id" "a"
          "calm.node-type" "service"
          "concordia.status" "none"
        }
      }
    }
    deploymentEnvironment "Default" {
      deploymentNode "NET" "" "network" {
        tags "concordia:deployment"
        properties {
          "calm.unique-id" "net"
        }
        deploymentNode "HOST" "" "service" {
          tags "concordia:deployment"
          properties {
            "calm.unique-id" "host"
          }
          containerInstance gu_a
          softwareSystemInstance gu_sys
        }
      }
    }
  }
  views {
    systemLandscape "landscape" {
      include *
      exclude "relationship.tag==concordia:observed-only"
      autoLayout
    }
    systemContext gu_gu_system_default "context-gu_gu_system_default" {
      include *
      exclude "relationship.tag==concordia:observed-only"
      autoLayout
    }
    container gu_gu_system_default "container-gu_gu_system_default" {
      include *
      exclude "relationship.tag==concordia:observed-only"
      autoLayout
    }
    container gu_gu_system_default "drift-gu_gu_system_default" {
      include *
      autoLayout
    }
    systemContext gu_sys "context-gu_sys" {
      include *
      exclude "relationship.tag==concordia:observed-only"
      autoLayout
    }
    container gu_sys "container-gu_sys" {
      include *
      exclude "relationship.tag==concordia:observed-only"
      autoLayout
    }
    container gu_sys "drift-gu_sys" {
      include *
      autoLayout
    }
    deployment * "Default" "deployment" {
      include *
      autoLayout
    }
    styles {
      relationship "concordia:conforming" {
        color #2e7d32
      thickness 2
      style solid
      }
      relationship "concordia:declared-only" {
        color #1565c0
      thickness 2
      style dashed
      }
      relationship "concordia:observed-only" {
        color #ef6c00
      thickness 3
      style dotted
      }
      relationship "concordia:unknown" {
        color #6a1b9a
      thickness 2
      style dotted
      }
      relationship "concordia:violating" {
        color #c62828
      thickness 4
      style solid
      }
    }
  }
}
