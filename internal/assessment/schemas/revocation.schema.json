{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concordia.io/schemas/v1alpha1/revocation.schema.json",
  "title": "Concordia AssessmentRevocation",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "id", "approval", "reviewer", "decidedAt", "reason"],
  "properties": {
    "apiVersion": { "const": "concordia.io/v1alpha1" },
    "kind": { "const": "AssessmentRevocation" },
    "id": { "$ref": "#/$defs/id" },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "authority"],
      "properties": {
        "identity": { "$ref": "#/$defs/nonEmptyString" },
        "authority": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "decidedAt": { "type": "string", "format": "date-time" },
    "reason": { "$ref": "#/$defs/nonEmptyString" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
