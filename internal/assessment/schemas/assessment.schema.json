{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concordia.io/schemas/v1alpha1/assessment.schema.json",
  "title": "Concordia Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "id",
    "version",
    "type",
    "scope",
    "environment",
    "subject",
    "assumptions",
    "evidence",
    "outcome"
  ],
  "properties": {
    "apiVersion": { "const": "concordia.io/v1alpha1" },
    "kind": { "const": "Assessment" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "type": "integer", "minimum": 1 },
    "type": { "enum": ["security", "quality"] },
    "title": { "$ref": "#/$defs/nonEmptyString" },
    "notes": { "type": "string" },
    "reviewed": {
      "description": "An informal flag that someone reviewed the document. It is a known key and has no effect: only a verified approval record gives the state approved.",
      "type": "boolean"
    },
    "scope": { "$ref": "#/$defs/scope" },
    "environment": { "$ref": "#/$defs/nonEmptyString" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{ "required": ["dependencies"] }, { "required": ["scenarios"] }],
      "properties": {
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/dependency" }
        },
        "scenarios": { "$ref": "#/$defs/stringList" }
      }
    },
    "assumptions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "outcome": {
      "enum": ["satisfactory", "satisfactory-with-conditions", "unsatisfactory", "inconclusive"]
    },
    "state": {
      "description": "The authored review state. Only draft and ready-for-review are authorable; any other value fails with CO-ASM-003.",
      "enum": ["draft", "ready-for-review", "approved", "rejected", "review-required", "expired", "revoked"]
    },
    "dispositions": {
      "type": "array",
      "items": { "$ref": "#/$defs/disposition" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "calmNodes": { "$ref": "#/$defs/stringList" },
        "calmRelationships": { "$ref": "#/$defs/stringList" },
        "nodeTypes": { "$ref": "#/$defs/stringList" },
        "tags": { "$ref": "#/$defs/stringList" }
      }
    },
    "dependencyKind": {
      "enum": [
        "runtime-identity",
        "role-binding",
        "secret-reference",
        "configuration-reference",
        "storage-reference",
        "public-entry-point",
        "protocol",
        "certificate-reference",
        "external-destination",
        "trust-context",
        "data-classification",
        "placement",
        "binding",
        "control",
        "implementation",
        "verification",
        "quality-scenario"
      ]
    },
    "selector": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
      "additionalProperties": {
        "oneOf": [{ "$ref": "#/$defs/nonEmptyString" }, { "$ref": "#/$defs/stringList" }]
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "selector"],
      "properties": {
        "kind": { "$ref": "#/$defs/dependencyKind" },
        "selector": { "$ref": "#/$defs/selector" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ref"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "ref": { "$ref": "#/$defs/nonEmptyString" },
        "digest": { "$ref": "#/$defs/digest" },
        "description": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "disposition"],
      "properties": {
        "identity": { "$ref": "#/$defs/nonEmptyString" },
        "disposition": { "enum": ["removed-intentionally", "retired", "moved"] },
        "movedTo": { "$ref": "#/$defs/nonEmptyString" },
        "reason": { "$ref": "#/$defs/nonEmptyString" }
      },
      "if": { "properties": { "disposition": { "const": "moved" } }, "required": ["disposition"] },
      "then": { "required": ["movedTo"] }
    }
  }
}
