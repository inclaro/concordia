{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concordia.io/schemas/v1alpha1/assumption.schema.json",
  "title": "Concordia Assumption",
  "description": "An assumption declares dependency selectors, explicit evidence, or both; one of the two is required (CO-ASM-001).",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "id", "statement", "scope", "owner", "verificationMethod"],
  "anyOf": [{ "required": ["selectors"] }, { "required": ["evidence"] }],
  "properties": {
    "apiVersion": { "const": "concordia.io/v1alpha1" },
    "kind": { "const": "Assumption" },
    "id": { "$ref": "#/$defs/id" },
    "statement": { "$ref": "#/$defs/nonEmptyString" },
    "scope": { "$ref": "#/$defs/scope" },
    "owner": { "$ref": "#/$defs/nonEmptyString" },
    "verificationMethod": { "$ref": "#/$defs/nonEmptyString" },
    "selectors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dependency" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "calmNodes": { "$ref": "#/$defs/stringList" },
        "calmRelationships": { "$ref": "#/$defs/stringList" },
        "nodeTypes": { "$ref": "#/$defs/stringList" },
        "tags": { "$ref": "#/$defs/stringList" }
      }
    },
    "dependencyKind": {
      "enum": [
        "runtime-identity",
        "role-binding",
        "secret-reference",
        "configuration-reference",
        "storage-reference",
        "public-entry-point",
        "protocol",
        "certificate-reference",
        "external-destination",
        "trust-context",
        "data-classification",
        "placement",
        "binding",
        "control",
        "implementation",
        "verification",
        "quality-scenario"
      ]
    },
    "selector": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
      "additionalProperties": {
        "oneOf": [{ "$ref": "#/$defs/nonEmptyString" }, { "$ref": "#/$defs/stringList" }]
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "selector"],
      "properties": {
        "kind": { "$ref": "#/$defs/dependencyKind" },
        "selector": { "$ref": "#/$defs/selector" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ref"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "ref": { "$ref": "#/$defs/nonEmptyString" },
        "digest": { "$ref": "#/$defs/digest" },
        "description": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
