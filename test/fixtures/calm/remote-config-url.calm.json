{
  "$schema": "https://calm.finos.org/release/1.2/meta/calm.json",
  "nodes": [
    {
      "unique-id": "customer",
      "node-type": "actor",
      "name": "Customer",
      "description": "A customer"
    },
    {
      "unique-id": "billing-service",
      "node-type": "service",
      "name": "Billing",
      "description": "Billing",
      "concordia": {
        "c4-level": "container",
        "owner": "team-billing",
        "tags": [
          "core"
        ],
        "bindings": [
          {
            "kind": "source-root",
            "value": "services/billing/**"
          }
        ]
      },
      "controls": {
        "architecture-001": {
          "description": "Boundaries",
          "requirements": [
            {
              "requirement-url": "https://calm.finos.org/release/1.2/meta/control.json",
              "config-url": "https://hub.example/cfg.json"
            }
          ]
        }
      }
    },
    {
      "unique-id": "fulfillment-service",
      "node-type": "service",
      "name": "Fulfillment",
      "description": "Fulfillment"
    }
  ],
  "relationships": [
    {
      "unique-id": "rel-bf",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "billing-service"
          },
          "destination": {
            "node": "fulfillment-service"
          }
        }
      },
      "protocol": "HTTPS",
      "concordia": {
        "observation": {
          "allowed-edge-kinds": [
            "IMPORTS",
            "calls"
          ],
          "minimum-confidence": "syntactic",
          "required": true
        }
      }
    },
    {
      "unique-id": "rel-ci",
      "relationship-type": {
        "interacts": {
          "actor": "customer",
          "nodes": [
            "billing-service"
          ]
        }
      }
    }
  ]
}
