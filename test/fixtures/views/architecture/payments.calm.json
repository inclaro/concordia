{
  "$schema": "https://calm.finos.org/release/1.2/meta/calm.json",
  "nodes": [
    {
      "unique-id": "customer",
      "node-type": "actor",
      "name": "Customer",
      "description": "A customer of the payments system"
    },
    {
      "unique-id": "payments-system",
      "node-type": "system",
      "name": "Payments",
      "description": "The payments system"
    },
    {
      "unique-id": "orders-service",
      "node-type": "service",
      "name": "Orders",
      "description": "Takes orders and asks for payment"
    },
    {
      "unique-id": "payments-db",
      "node-type": "database",
      "name": "Payments database",
      "description": "Stores payments"
    }
  ],
  "relationships": [
    {
      "unique-id": "payments-composition",
      "description": "Payments is composed of the orders service and its database.",
      "relationship-type": {
        "composed-of": {
          "container": "payments-system",
          "nodes": ["orders-service", "payments-db"]
        }
      }
    },
    {
      "unique-id": "orders-to-db",
      "description": "Orders stores payments.",
      "relationship-type": {
        "connects": {
          "source": { "node": "orders-service" },
          "destination": { "node": "payments-db" }
        }
      },
      "protocol": "TCP"
    },
    {
      "unique-id": "customer-uses-orders",
      "relationship-type": {
        "interacts": {
          "actor": "customer",
          "nodes": ["orders-service"]
        }
      }
    }
  ]
}
