{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "nodes": {
      "prefixItems": [
        {
          "properties": {
            "unique-id": {
              "const": "webapp"
            }
          }
        }
      ]
    },
    "relationships": {
      "prefixItems": [
        {
          "properties": {
            "unique-id": {
              "const": "r"
            },
            "relationship-type": {
              "const": {
                "connects": {
                  "source": {
                    "interfaces": [
                      "intf2"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "interfaces": {
    "prefixItems": [
      {
        "properties": {
          "unique-id": {
            "const": "intf1"
          }
        }
      }
    ]
  }
}
