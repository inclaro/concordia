{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "nodes": {
      "prefixItems": [
        {
          "properties": {
            "unique-id": {
              "const": "webapp"
            }
          }
        },
        {
          "oneOf": [
            {
              "properties": {
                "unique-id": {
                  "const": "cache"
                }
              }
            }
          ]
        }
      ]
    },
    "relationships": {
      "prefixItems": [
        {
          "properties": {
            "unique-id": {
              "const": "r1"
            },
            "relationship-type": {
              "const": {
                "composed-of": {
                  "nodes": [
                    "typo"
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
