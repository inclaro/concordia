{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "nodes": {
      "prefixItems": [
        {
          "properties": {
            "unique-id": {
              "const": "webapp"
            }
          }
        },
        {
          "properties": {
            "unique-id": {
              "const": "database"
            }
          }
        }
      ]
    },
    "relationships": {
      "prefixItems": [
        {
          "properties": {
            "unique-id": {
              "const": "w-d"
            },
            "relationship-type": {
              "const": {
                "connects": {
                  "source": {
                    "node": "webapp"
                  },
                  "destination": {
                    "node": "database"
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "unique-id": {
              "const": "d"
            },
            "relationship-type": {
              "properties": {
                "options": {
                  "prefixItems": [
                    {
                      "anyOf": [
                        {
                          "properties": {
                            "unique-id": {
                              "const": "a"
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
