{
  "$schema": "https://calm.finos.org/release/1.3/meta/calm.json",
  "nodes": [
    {
      "unique-id": "web",
      "node-type": "webclient",
      "name": "Web",
      "description": "The web client",
      "interfaces": [
        {
          "unique-id": "web-http",
          "url": "https://web.example.com"
        }
      ]
    },
    {
      "unique-id": "api",
      "node-type": "service",
      "name": "API",
      "description": "The API",
      "interfaces": [
        {
          "unique-id": "api-http",
          "host": "api.example.com",
          "port": 443
        }
      ]
    }
  ],
  "relationships": [
    {
      "unique-id": "web-api",
      "description": "Web calls the API",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "web",
            "interfaces": [
              "web-http"
            ]
          },
          "destination": {
            "node": "api",
            "interfaces": [
              "api-http"
            ]
          }
        }
      }
    }
  ],
  "flows": [
    {
      "unique-id": "flow",
      "name": "Flow",
      "description": "A flow",
      "transitions": [
        {
          "relationship-unique-id": "web-api",
          "sequence-number": 1,
          "description": "step"
        },
        {
          "relationship-unique-id": "web-api",
          "sequence-number": 2,
          "description": "step"
        }
      ]
    }
  ]
}
