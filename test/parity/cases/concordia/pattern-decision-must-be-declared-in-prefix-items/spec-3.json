{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "nodes": {
      "prefixItems": [
        {
          "properties": {
            "unique-id": {
              "const": "webapp"
            }
          }
        },
        {
          "properties": {
            "unique-id": {
              "const": "database"
            }
          }
        }
      ]
    },
    "relationships": {
      "prefixItems": [],
      "items": {
        "anyOf": [
          {
            "properties": {
              "unique-id": {
                "const": "w-d"
              },
              "relationship-type": {
                "const": {
                  "connects": {
                    "source": {
                      "node": "webapp"
                    },
                    "destination": {
                      "node": "database"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
