{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/patterns/web-api.pattern.json",
  "title": "Web and API",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "$ref": "https://calm.finos.org/release/1.3/meta/core.json#/defs/node",
          "properties": {
            "unique-id": {
              "const": "web"
            }
          }
        },
        {
          "$ref": "https://calm.finos.org/release/1.3/meta/core.json#/defs/node",
          "properties": {
            "unique-id": {
              "const": "api"
            }
          }
        }
      ]
    },
    "relationships": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {
          "$ref": "https://calm.finos.org/release/1.3/meta/core.json#/defs/relationship",
          "properties": {
            "unique-id": {
              "const": "web-api"
            },
            "relationship-type": {
              "const": {
                "connects": {
                  "source": {
                    "node": "web"
                  },
                  "destination": {
                    "node": "api"
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "nodes",
    "relationships"
  ]
}
