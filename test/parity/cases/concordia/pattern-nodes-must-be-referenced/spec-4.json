{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "nodes": {
      "prefixItems": [
        {
          "properties": {
            "unique-id": {
              "const": "webapp"
            }
          }
        },
        {
          "properties": {
            "unique-id": {
              "const": "database"
            }
          }
        }
      ],
      "items": {
        "oneOf": [
          {
            "properties": {
              "unique-id": {
                "const": "orphan"
              }
            }
          }
        ]
      }
    },
    "relationships": {
      "prefixItems": [
        {
          "properties": {
            "unique-id": {
              "const": "w-d"
            },
            "relationship-type": {
              "const": {
                "connects": {
                  "source": {
                    "node": "webapp"
                  },
                  "destination": {
                    "node": "database"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
