{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "nodes": {
      "prefixItems": [
        {
          "properties": {
            "unique-id": {
              "const": "node1"
            },
            "interfaces": {
              "prefixItems": [
                {
                  "properties": {
                    "unique-id": {
                      "const": "intf1"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "relationships": {
      "prefixItems": [
        {
          "properties": {
            "unique-id": {
              "const": "r"
            },
            "relationship-type": {
              "const": {
                "connects": {
                  "destination": {
                    "node": "node1",
                    "interfaces": [
                      "intf1",
                      "intf2"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
