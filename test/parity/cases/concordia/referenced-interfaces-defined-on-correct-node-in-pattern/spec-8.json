{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "nodes": {
      "prefixItems": [
        {
          "oneOf": [
            {
              "properties": {
                "unique-id": {
                  "const": "cache"
                }
              }
            },
            {
              "properties": {
                "unique-id": {
                  "const": "queue"
                },
                "interfaces": {
                  "prefixItems": [
                    {
                      "properties": {
                        "unique-id": {
                          "const": "queue-port"
                        }
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    "relationships": {
      "prefixItems": [
        {
          "properties": {
            "unique-id": {
              "const": "r"
            },
            "relationship-type": {
              "const": {
                "connects": {
                  "destination": {
                    "node": "queue",
                    "interfaces": [
                      "missing-port"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
